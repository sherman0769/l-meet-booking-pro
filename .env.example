# 基礎 / admin / Firebase
# ========================================
ADMIN_PASSWORD=<replace-with-admin-password>
ADMIN_SESSION_SECRET=<replace-with-admin-session-secret>
FIREBASE_PROJECT_ID=<replace-with-firebase-project-id>
FIREBASE_CLIENT_EMAIL=<replace-with-firebase-client-email>
# 需要 escaped newline (\n) 的 PEM 格式私鑰
FIREBASE_PRIVATE_KEY=<replace-with-escaped-firebase-private-key>
NODE_ENV=development

# Google Calendar / OAuth
# ========================================
GOOGLE_CLIENT_ID=<replace-with-google-client-id>
GOOGLE_CLIENT_SECRET=<replace-with-google-client-secret>
GOOGLE_REDIRECT_URI=<replace-with-google-redirect-uri>
GOOGLE_CALENDAR_ID=<replace-with-google-calendar-id>
# legacy fallback，優先使用 Firestore system_config/google_oauth
# 建議預設留空
GOOGLE_REFRESH_TOKEN=
GOOGLE_BLOCKING_CALENDAR_IDS=

# Internal / Cron
# ========================================
CRON_SECRET=<replace-with-cron-bearer-secret>
AUTO_RETRY_DRY_RUN_SECRET=
AUTO_RETRY_DRY_RUN_ALLOW_PRODUCTION=false

# LINE
# ========================================
# 用於 webhook x-line-signature 驗證
LINE_CHANNEL_SECRET=<replace-with-line-channel-secret>
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_TO=
# 建議預設為 false，避免測試環境外發送
LINE_ALERT_ENABLED=false
LINE_TEST_SECRET=
LINE_TEST_ALLOW_PRODUCTION=false

# LLM parser
# ========================================
# LLM 未設定時可 fallback 到規則 parser
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# Rate limit / Upstash
# ========================================
# 未設定時會 fallback 到 memory rate limit
# production 環境建議設定以確保穩定速率限制
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
